---
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import * as stylex from '@stylexjs/stylex'
import '../styles/global.css'
import { styles } from '../styles/home.stylex'

const title = 'krmznkr — full-stack software engineer'
const description =
  'krmznkr — a full-stack software engineer. Calm, careful software, built in the open.'
const url = 'https://me.krmznkr.com'

const links = [
  { label: 'GitHub', href: 'https://github.com/krmznkr' },
  { label: 'Julian', href: 'https://julian.krmznkr.com' },
  { label: 'Life', href: 'https://life.krmznkr.com' },
]
---

<!doctype html>
<html lang="en" class:list={['js', stylex.attrs(styles.html).class]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060608" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${url}/og.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${url}/og.svg`} />

    {
      import.meta.env.DEV && (
        <>
          <link rel="stylesheet" href="/virtual:stylex.css" />
          <script is:inline type="module" src="/@id/virtual:stylex:runtime"></script>
        </>
      )
    }

    <noscript>
      <style>
        html.js .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>

  <body {...stylex.attrs(styles.body)}>
    <canvas id="hyperion" {...stylex.attrs(styles.canvas)} aria-hidden="true"></canvas>
    <div {...stylex.attrs(styles.fixedAtmosphere, styles.aurora)} aria-hidden="true"></div>
    <div {...stylex.attrs(styles.fixedAtmosphere, styles.vignette)} aria-hidden="true"></div>
    <div {...stylex.attrs(styles.fixedAtmosphere, styles.grain)} aria-hidden="true"></div>

    <main {...stylex.attrs(styles.main)}>
      <header class:list={['topbar', stylex.attrs(styles.topbar).class]}>
        <span class:list={['reveal', stylex.attrs(styles.mark).class]}>krmznkr</span>
        <span class:list={['reveal', stylex.attrs(styles.place).class]}>Open source · privacy-minded · signal 144m</span>
      </header>

      <aside class:list={['scene-meta', 'reveal', stylex.attrs(styles.sceneMeta).class]} aria-hidden="true">
        <span>HYPERION / 13TH FLEET</span>
        <span>DRAG TO ORBIT</span>
        <span {...stylex.attrs(styles.sceneCredit)}>MESH / SIR TOPHAM HATT</span>
      </aside>

      <div {...stylex.attrs(styles.bottom)}>
        <section {...stylex.attrs(styles.intro)}>
          <p class:list={['kicker', 'reveal', stylex.attrs(styles.kicker).class]}>Hey — my name is</p>
          <h1 class:list={['heading', 'reveal', stylex.attrs(styles.heading).class]}>krmznkr</h1>
          <p class:list={['lede', 'reveal', stylex.attrs(styles.lede).class]}>
            I'm a full-stack software engineer building calm, careful software
            in the open.
          </p>

          <nav class:list={['links', 'reveal', stylex.attrs(styles.links).class]} aria-label="Elsewhere">
            {
              links.map((l) => (
                <a
                  href={l.href}
                  rel="me noopener"
                  target="_blank"
                  data-analytics-destination={l.label.toLowerCase()}
                  class:list={['link', stylex.attrs(styles.link).class]}
                >
                  <span>{l.label}</span>
                  <svg class:list={['link-icon', stylex.attrs(styles.linkIcon).class]} viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                    <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.1" fill="none" stroke-linecap="square" />
                  </svg>
                </a>
              ))
            }
          </nav>
        </section>

        <footer class:list={['footer', 'reveal', stylex.attrs(styles.footer).class]}>
          <span>Open source</span>
          <span {...stylex.attrs(styles.separator)} aria-hidden="true">/</span>
          <a
            href="https://github.com/krmznkr/me"
            rel="noopener"
            target="_blank"
            data-analytics-destination="source"
            {...stylex.attrs(styles.footerLink)}
          >this page</a>
        </footer>
      </div>

      <button class:list={['motion-control', 'reveal', stylex.attrs(styles.motionControl).class]} type="button" aria-pressed="false">
        <span class:list={['motion-icon', stylex.attrs(styles.motionIcon).class]} aria-hidden="true"></span>
        <span class="motion-label">Pause drift</span>
      </button>
    </main>

    <script>
      import '../scripts/sentry'
      import { capturePostHogEvent } from '../scripts/posthog'
      document.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof Element)) return

        const link = target.closest<HTMLAnchorElement>('a[data-analytics-destination]')
        if (!link) return

        capturePostHogEvent('outbound_link_clicked', {
          destination: link.dataset.analyticsDestination,
        })
      })
      const canvas = document.getElementById('hyperion') as HTMLCanvasElement | null
      const motionControl = document.querySelector<HTMLButtonElement>('.motion-control')
      if (canvas) {
        import('../scripts/hyperion').then(({ startHyperion }) => startHyperion(canvas)).then((scene) => {
          motionControl?.addEventListener('click', () => {
            const paused = scene.toggleMotion()
            motionControl.setAttribute('aria-pressed', String(paused))
            const label = motionControl.querySelector('.motion-label')
            if (label) label.textContent = paused ? 'Resume drift' : 'Pause drift'
          })
        }).catch((error) => {
          console.error('Hyperion scene failed to load', error)
          document.documentElement.classList.add('scene-error')
        })
      }
      requestAnimationFrame(() =>
        requestAnimationFrame(() =>
          document.documentElement.classList.add('ready'),
        ),
      )
    </script>

  </body>
</html>
